# Postgres — remapped off 5432 to avoid colliding with other local Postgres instances
DATABASE_URL=postgres://pulsegrid:pulsegrid@localhost:5435/pulsegrid

# Redis — remapped off 6379/6380 for the same reason
REDIS_URL=redis://localhost:6382

# NATS — default port, adjust if 4222 is already in use on your machine
NATS_URL=nats://localhost:4222

# JWT signing secret — MUST be changed before any real deployment
JWT_SECRET=change-me-in-production

# Coordinator HTTP port — moved off 8080, which commonly collides with
# other local dev servers/gateways
COORDINATOR_PORT=8090

# Fanout worker WS/HTTP port
FANOUT_WORKER_PORT=8081

# Comma-separated geohash prefixes this fanout-worker instance owns.
# Must match (or cover) the geographic area your registered devices and
# fired alerts fall within, or connections will be rejected with 421.
# Example values below cover Karachi, Pakistan (24.86, 67.00) at a
# 4-character geohash prefix radius.
FANOUT_WORKER_SHARD_PREFIXES=tkrt,tkrw,tkrs,tkrv

RUST_LOG=info,api_coordinator=debug,fanout_worker=debug
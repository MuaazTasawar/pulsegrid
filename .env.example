# =====================================================================
# PulseGrid configuration for host-side runs (cargo run)
# Generate real secrets and merge new keys into your .env with:
#     .\scripts\gen-secrets.ps1
# =====================================================================

# dev | production. In production, weak or default secrets make the
# services refuse to start.
PULSEGRID_ENV=dev

# --- Infrastructure (host ports remapped to avoid local clashes) ------
DATABASE_URL=postgres://pulsegrid:pulsegrid@localhost:5435/pulsegrid
REDIS_URL=redis://localhost:6382
NATS_URL=nats://localhost:4222

# --- Auth (api-coordinator) -------------------------------------------
# HS256 signing secret (>= 32 chars in production).
JWT_SECRET=change-me-in-production
# Optional EdDSA (Ed25519): when JWT_PRIVATE_KEY_PATH is set the
# coordinator signs with it and verifies with JWT_PUBLIC_KEY_PATH.
# JWT_PRIVATE_KEY_PATH=secrets/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=secrets/jwt_public.pem
DEVICE_TOKEN_TTL_HOURS=720
WS_TICKET_TTL_SECS=30

# Comma-separated operator API keys, sent as the X-API-Key header to
# POST /alerts, /admin/* and the dashboard (>= 32 chars in production).
OPERATOR_API_KEYS=change-me-dev-operator-key

# --- api-coordinator --------------------------------------------------
COORDINATOR_PORT=8090
# pretty | json
LOG_FORMAT=pretty
# Rate limits: requests PER SECOND per client IP, plus a burst allowance.
RATE_LIMIT_REGISTER_PER_SEC=5
RATE_LIMIT_REGISTER_BURST=10
RATE_LIMIT_LOCATION_PER_SEC=10
RATE_LIMIT_LOCATION_BURST=20
RATE_LIMIT_ALERTS_PER_SEC=2
RATE_LIMIT_ALERTS_BURST=5
# true disables the coordinator rate limits (load testing only!)
RATE_LIMIT_DISABLED=false
# Data lifecycle
DEVICE_RETENTION_DAYS=90
ALERT_RETENTION_DAYS=365
RETENTION_SWEEP_INTERVAL_MINUTES=60
# How long alerts stay replayable in the JetStream alert stream
ALERT_STREAM_MAX_AGE_SECS=3600

# --- fanout-worker ----------------------------------------------------
FANOUT_WORKER_PORT=8081
# Comma-separated geohash prefixes this worker owns (Karachi example)
FANOUT_WORKER_SHARD_PREFIXES=tkrt,tkrw,tkrs,tkrv
# URL clients use to reach THIS worker (public hostname / load balancer)
WORKER_PUBLIC_URL=ws://localhost:8081
SHARD_LEASE_TTL_SECS=30
WS_CONNECT_RATE_PER_SEC=50
WS_CONNECT_BURST=100
REPLAY_MAX_ALERTS=50

RUST_LOG=info,api_coordinator=debug,fanout_worker=debug
